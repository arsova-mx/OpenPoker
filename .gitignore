# ─────────────────────────────────────────
#  OpenPoker – .gitignore
#  Covers: Java/Maven (backend) + Node/React (frontend)
# ─────────────────────────────────────────

# ── OS ──────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# ── IDE / Editors ────────────────────────
.idea/
*.iml
*.iws
.vscode/
*.suo
*.user
*.userosscache
*.sln.docstates
nbproject/
.project
.classpath
.settings/
*.launch

# ── Java / Maven (backend) ───────────────
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar
!backend/.mvn/wrapper/maven-wrapper.properties
*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar
hs_err_pid*
replay_pid*

# Spring Boot
backend/src/main/resources/application-local.properties
backend/src/main/resources/application-local.yml

# ── Node / React (frontend) ──────────────
frontend/node_modules/
frontend/dist/
frontend/.cache/
frontend/.parcel-cache/
frontend/coverage/
frontend/.env
frontend/.env.local
frontend/.env.*.local

# Vite
frontend/.vite/
frontend/vite.config.js
frontend/vite.config.d.ts
frontend/tsconfig.tsbuildinfo

# npm / yarn / pnpm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tsbuildinfo

# ── Docker ───────────────────────────────
.docker/

# ── Environment ──────────────────────────
.env

# ── Misc ─────────────────────────────────
*.log
*.pid
*.seed
*.pid.lock
