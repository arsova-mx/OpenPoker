# ─────────────────────────────────────────
#  OpenPoker – Environment Variables
#  Copy this file to .env and fill in the empty values:
#    cp .env.example .env
#  Never commit your .env file.
# ─────────────────────────────────────────

# ── Database (PostgreSQL) ────────────────
POSTGRES_DB=openpoker
POSTGRES_USER=openpoker
# Required. Use a strong, unique password.
POSTGRES_PASSWORD=

# ── Backend (Spring Boot) ────────────────
# Required. HS256 signing key of at least 32 bytes. Generate a new one with:
#   openssl rand -base64 48
JWT_SECRET=
# Token lifetime in milliseconds (default: 1 hour)
JWT_EXPIRATION_MS=3600000
BACKEND_PORT=8080

# ── Frontend ─────────────────────────────
FRONTEND_PORT=3000
# Base URL of the REST API, baked into the frontend at build time.
# Keep it relative ("/api") when the frontend and backend share the same origin.
VITE_API_URL=/api
