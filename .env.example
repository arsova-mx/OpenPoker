# ─────────────────────────────────────────
#  OpenPoker – Environment Variables
#  Copy this file to .env and adjust values
# ─────────────────────────────────────────

# ── PostgreSQL ───────────────────────────
POSTGRES_DB=openpoker
POSTGRES_USER=openpoker
POSTGRES_PASSWORD=openpoker_secret
POSTGRES_PORT=5432

# ── Backend (Spring Boot) ────────────────
BACKEND_PORT=8080

# ── Frontend ─────────────────────────────
FRONTEND_PORT=3000
VITE_API_URL="http://localhost:"
